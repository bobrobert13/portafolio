# Absolute site URL. Used for canonical links and hreflang, and as Astro's `site`.
# No trailing slash.
PUBLIC_SITE_URL=https://example.com

# Display name shown in the header, footer and page titles.
PUBLIC_SITE_NAME=Trebor

# Optional. When set, every contact button links to this address with mailto:.
# Without it, contact links fall back to the in-page `#contacto` section.
PUBLIC_CONTACT_EMAIL=
