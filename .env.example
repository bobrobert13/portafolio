# Absolute site URL. Used for canonical links, hreflang, sitemap and robots.
# Required for production builds; must use https:// in production.
# No trailing slash.
PUBLIC_SITE_URL=https://example.com

# Display name shown in the header, footer and page titles.
PUBLIC_SITE_NAME=Trebor

# Optional. When set, the contact form and every contact button use this address.
# Without it, the form renders but cannot send, and contact links fall back to
# the in-page `#contacto` section.
PUBLIC_CONTACT_EMAIL=
