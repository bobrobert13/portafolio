---
import '@/infra/styles/global.css';
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import LocaleSwitcher from '@/infra/components/LocaleSwitcher.vue';
import ThemeToggle from '@/infra/components/ThemeToggle.astro';
import { defaultLocale, locales, site, type Locale } from '@/config';
import { localePath } from '@/i18n/utils';
import { t } from '@/i18n/ui';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** Route path without the locale prefix, e.g. `''` or `'projects'`. */
	path?: string;
}

const { locale, title, description, path = '' } = Astro.props;

const absoluteUrl = (localeCode: Locale) =>
	new URL(localePath(localeCode, path), `${site.url}/`).href;

const canonical = absoluteUrl(locale);
const localeHome = localePath(locale);
const sectionHref = (hash: string) => `${localeHome}#${hash}`;
const contactHref = site.contactEmail
	? `mailto:${site.contactEmail}`
	: sectionHref('perfil-contacto');
const year = new Date().getFullYear();

const navItems = [
	{ key: 'nav.about' as const, href: sectionHref('perfil') },
	{ key: 'nav.process' as const, href: sectionHref('construccion') },
	{ key: 'nav.projects' as const, href: sectionHref('proyectos') },
	{ key: 'nav.tools' as const, href: sectionHref('herramientas') },
];

const footerSections = [
	{ key: 'nav.home' as const, href: localeHome },
	...navItems,
];
---

<!doctype html>
<html lang={locale}>
	<head>
		<script is:inline>
			try {
				const stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.dataset.theme = stored;
				}
			} catch {
				/* storage can be unavailable in private contexts */
			}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{
			locales.map((code) => (
				<link rel="alternate" hreflang={code} href={absoluteUrl(code)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultLocale)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale} />
	</head>
	<body class="flex min-h-dvh flex-col">
		<div class="site-frame flex flex-1 flex-col">
			<a class="skip-link" href="#main">{t(locale, 'a11y.skipToContent')}</a>

			<header class="site-header sticky top-0 z-50 border-b border-line bg-page/85 backdrop-blur-md">
				<div class="flex h-[62px] items-center gap-3 px-[1.125rem] md:gap-5 md:px-6 lg:px-11">
					<a
						class="text-[17px] font-bold tracking-[-0.5px]"
						href={localeHome}
					>
						{site.name}
					</a>

					<nav
						class="hidden items-center gap-0.5 md:flex"
						aria-label={t(locale, 'a11y.mainNav')}
					>
						{
							navItems.map((item) => (
								<a
									class="rounded-nav px-2.5 py-[7px] text-[13px] text-muted transition-colors hover:bg-ink/5 hover:text-ink"
									href={item.href}
								>
									{t(locale, item.key)}
								</a>
							))
						}
					</nav>

					<div class="ml-auto flex items-center gap-4">
						<LocaleSwitcher current={locale} path={path} />
						<ThemeToggle label={t(locale, 'theme.toggle')} />
						<a
							class="hidden min-h-8 items-center gap-2 rounded-cta bg-accent px-3.5 py-[7px] text-xs font-bold text-accent-ink shadow-btn transition-[filter] duration-150 hover:brightness-105 sm:inline-flex"
							href={contactHref}
						>
							{t(locale, 'cta.contact')}
							<ArrowIcon class="size-3.5 shrink-0" />
						</a>
					</div>
				</div>
			</header>

			<main id="main" class="flex-1">
				<slot />
			</main>

			<footer class="border-t border-line">
				<div class="px-[1.125rem] pt-12 md:px-6 md:pt-14 lg:px-11 lg:pt-[3.75rem]">
					<div
						class="grid grid-cols-2 gap-x-5 gap-y-10 pb-11 md:gap-8 md:pb-14 lg:grid-cols-[1.15fr_1fr_1fr]"
					>
						<div class="col-span-2 md:col-span-1">
							<a class="text-[17px] font-bold tracking-[-0.5px]" href={localeHome}>
								{site.name}
							</a>
							<p class="mt-3.5 max-w-56 text-[13px] leading-relaxed text-muted">
								{t(locale, 'footer.tagline')}
							</p>
						</div>

						<nav aria-label={t(locale, 'a11y.footerNav')}>
							<h2 class="mb-4.5 text-sm font-semibold">{t(locale, 'footer.explore')}</h2>
							<ul class="space-y-3 text-[13px] text-muted">
								{
									footerSections.map((item) => (
										<li>
											<a class="transition-colors hover:text-ink" href={item.href}>
												{t(locale, item.key)}
											</a>
										</li>
									))
								}
							</ul>
						</nav>

						<div>
							<h2 class="mb-4.5 text-sm font-semibold">{t(locale, 'footer.contact')}</h2>
							<ul class="space-y-3 text-[13px] text-muted">
								<li>
									<a class="transition-colors hover:text-ink" href={contactHref}>
										{t(locale, 'cta.contact')}
									</a>
								</li>
								{
									site.contactEmail && (
										<li>
											<a
												class="transition-colors hover:text-ink"
												href={`mailto:${site.contactEmail}`}
											>
												{site.contactEmail}
											</a>
										</li>
									)
								}
							</ul>
						</div>
					</div>

					<div
						class="flex flex-col gap-2.5 border-t border-line py-6 pe-16 text-[11px] text-subtle md:flex-row md:items-center md:justify-between"
					>
						<p>© {year} {site.name}. {t(locale, 'footer.rights')}</p>
						<p>{t(locale, 'footer.builtWith')}</p>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
