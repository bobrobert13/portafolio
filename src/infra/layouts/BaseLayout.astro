---
import '@/infra/styles/global.css';
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import LocaleSwitcher from '@/infra/components/LocaleSwitcher.vue';
import ThemeToggle from '@/infra/components/ThemeToggle.astro';
import { defaultLocale, locales, site, type Locale } from '@/config';
import { alternateLocale, localePath } from '@/i18n/utils';
import { t } from '@/i18n/ui';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** Route path without the locale prefix, e.g. `''` or `'projects'`. */
	path?: string;
	/** Keeps error pages out of the index and drops their canonical metadata. */
	noindex?: boolean;
}

const { locale, title, description, path = '', noindex = false } = Astro.props;

const absoluteUrl = (localeCode: Locale) =>
	new URL(localePath(localeCode, path), `${site.url}/`).href;

const canonical = absoluteUrl(locale);
const ogLocales: Record<Locale, string> = { es: 'es_ES', en: 'en_US' };
const ogImage = new URL(`/og/${locale}.jpg`, `${site.url}/`).href;
const ogLocale = ogLocales[locale];
const alternateOgLocale = ogLocales[alternateLocale(locale)];
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site.url}/#website`,
			url: `${site.url}/`,
			name: site.name,
			description,
			inLanguage: locale,
			publisher: { '@id': `${site.url}/#person` },
		},
		{
			'@type': 'Person',
			'@id': `${site.url}/#person`,
			name: site.name,
			alternateName: 'Robert Caraballo',
			jobTitle: 'Web developer',
			url: `${site.url}/`,
			image: ogImage,
			knowsAbout: [
				'Astro',
				'Vue',
				'TypeScript',
				'Web accessibility',
				'Static site generation',
			],
			sameAs: [site.socials.linkedin, site.socials.github],
		},
	],
};
const localeHome = localePath(locale);
const sectionHref = (hash: string) => `${localeHome}#${hash}`;
const contactHref = site.contactEmail
	? `mailto:${site.contactEmail}`
	: sectionHref('contacto');
const year = new Date().getFullYear();

const navItems = [
	{ key: 'nav.about' as const, href: sectionHref('perfil') },
	{ key: 'nav.process' as const, href: sectionHref('construccion') },
	{ key: 'nav.projects' as const, href: sectionHref('proyectos') },
	{ key: 'nav.tools' as const, href: sectionHref('herramientas') },
];

const footerSections = [
	{ key: 'nav.home' as const, href: localeHome },
	...navItems,
];
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			try {
				const stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.dataset.theme = stored;
				}
			} catch {
				/* storage can be unavailable in private contexts */
			}

			/* A hash in the URL owns the position: the sheet script re-applies it
			   after layout, so the browser must not restore an older scroll. */
			if (location.hash) history.scrollRestoration = 'manual';
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#eedfc7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#241708" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{!noindex && <link rel="canonical" href={canonical} />}
		{
			!noindex &&
			locales.map((code) => (
				<link rel="alternate" hreflang={code} href={absoluteUrl(code)} />
			))
		}
		{!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultLocale)} />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={alternateOgLocale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{
			!noindex && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
				/>
			)
		}
	</head>
	<body class="flex min-h-dvh flex-col">
		<div class="site-frame flex flex-1 flex-col">
			<a class="skip-link" href="#main">{t(locale, 'a11y.skipToContent')}</a>
			<div class="scroll-blur" aria-hidden="true"></div>

			<header class="site-header sticky top-0 z-50 border-b border-line bg-page/85 backdrop-blur-md">
				<div class="flex h-[62px] items-center gap-3 px-[1.125rem] md:gap-5 md:px-6 lg:px-11">
					<a
						class="text-[17px] font-bold tracking-[-0.5px]"
						href={localeHome}
					>
						{site.name}
					</a>

					<nav
						class="hidden items-center gap-0.5 md:flex"
						aria-label={t(locale, 'a11y.mainNav')}
					>
						{
							navItems.map((item) => (
								<a
									class="rounded-nav px-2.5 py-[7px] text-[13px] text-muted transition-colors hover:bg-ink/5 hover:text-ink"
									href={item.href}
								>
									{t(locale, item.key)}
								</a>
							))
						}
					</nav>

					<div class="ml-auto flex items-center gap-4">
						<LocaleSwitcher current={locale} path={path} />
						<ThemeToggle label={t(locale, 'theme.toggle')} />
						<a
							class="hidden min-h-8 items-center gap-2 rounded-cta bg-accent px-3.5 py-[7px] text-xs font-bold text-accent-ink shadow-btn transition-[filter] duration-150 hover:brightness-105 sm:inline-flex"
							href={contactHref}
						>
							{t(locale, 'cta.contact')}
							<ArrowIcon class="size-3.5 shrink-0" />
						</a>
					</div>
				</div>

				<noscript>
					<nav
						class="px-[1.125rem] pb-3 md:hidden"
						aria-label={t(locale, 'a11y.mainNav')}
					>
						<ul class="flex flex-wrap gap-x-4 gap-y-2 text-[13px]" role="list">
							{
								navItems.map((item) => (
									<li>
										<a class="text-muted hover:text-ink" href={item.href}>
											{t(locale, item.key)}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
				</noscript>
			</header>

			<main id="main" class="flex-1" tabindex="-1">
				<slot />
			</main>

			<footer class="border-t border-line">
				<div class="px-[1.125rem] pt-12 md:px-6 md:pt-14 lg:px-11 lg:pt-[3.75rem]">
					<div
						class="grid grid-cols-2 gap-x-5 gap-y-10 pb-11 md:gap-8 md:pb-14 lg:grid-cols-[1.15fr_1fr_1fr]"
					>
						<div class="col-span-2 md:col-span-1">
							<a class="text-[17px] font-bold tracking-[-0.5px]" href={localeHome}>
								{site.name}
							</a>
							<p class="mt-3.5 max-w-56 text-[13px] leading-relaxed text-muted">
								{t(locale, 'footer.tagline')}
							</p>
						</div>

						<nav aria-label={t(locale, 'a11y.footerNav')}>
							<h2 class="mb-4.5 text-sm font-semibold">{t(locale, 'footer.explore')}</h2>
							<ul class="space-y-3 text-[13px] text-muted" role="list">
								{
									footerSections.map((item) => (
										<li>
											<a class="transition-colors hover:text-ink" href={item.href}>
												{t(locale, item.key)}
											</a>
										</li>
									))
								}
							</ul>
						</nav>

						<div>
							<h2 class="mb-4.5 text-sm font-semibold">{t(locale, 'footer.contact')}</h2>
							<ul class="space-y-3 text-[13px] text-muted" role="list">
								<li>
									<a class="transition-colors hover:text-ink" href={contactHref}>
										{t(locale, 'cta.contact')}
									</a>
								</li>
								{
									site.contactEmail && (
										<li>
											<a
												class="transition-colors hover:text-ink"
												href={`mailto:${site.contactEmail}`}
											>
												{site.contactEmail}
											</a>
										</li>
									)
								}
							</ul>
						</div>
					</div>

					<div
						class="flex flex-col gap-2.5 border-t border-line pt-6 pb-20 text-[11px] text-subtle md:flex-row md:items-center md:justify-between md:pb-6"
					>
						<p>© {year} {site.name}. {t(locale, 'footer.rights')}</p>
						<p>{t(locale, 'footer.builtWith')}</p>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
