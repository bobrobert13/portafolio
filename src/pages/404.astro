---
import BaseLayout from '@/infra/layouts/BaseLayout.astro';
import BaseButton from '@/infra/components/BaseButton.vue';

const title = 'Página no encontrada · Trebor';
const description = 'La página que buscas no existe. Vuelve al inicio del portafolio.';
---

<BaseLayout locale="es" title={title} description={description} noindex>
	<section class="page-container flex min-h-[60vh] flex-col justify-center py-24">
		<p class="eyebrow">404</p>
		<h1 class="mt-5 max-w-[18ch] text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.95] tracking-[-0.04em]">
			Esta página no existe.
		</h1>
		<p class="mt-5 max-w-xl text-[17px] leading-[1.7] text-muted">
			Puede que el enlace haya cambiado o que la página ya no esté.
		</p>
		<p lang="en" class="mt-3 max-w-xl text-[15px] leading-[1.7] text-muted">
			The page you are looking for does not exist.
		</p>
		<div class="mt-8 flex flex-wrap gap-2.5">
			<BaseButton href="/es/">Volver al inicio</BaseButton>
			<BaseButton href="/en/" variant="ghost">Go to the English site</BaseButton>
		</div>
	</section>
</BaseLayout>
