---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import { site, type Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].about;
const contactHref = site.contactEmail ? `mailto:${site.contactEmail}` : '#contacto';
---

<section
	id="sobre-mi"
	class="grid border-b border-line lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
>
	<div class="rail-anim rail-media relative min-h-[360px] overflow-hidden lg:min-h-[465px]">
		<div
			class="absolute inset-0 bg-[radial-gradient(at_35%_80%,color-mix(in_oklab,var(--color-accent)_28%,transparent),transparent_70%)]"
			aria-hidden="true"
		>
		</div>
		<img
			src="/img/portrait-placeholder.jpg"
			alt=""
			width="1200"
			height="1800"
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-[center_25%] grayscale [mask-image:linear-gradient(#000_78%,transparent_100%)]"
		/>
	</div>

	<div
		class="rail-anim px-[1.125rem] py-14 md:px-9 lg:max-w-[52rem] lg:py-[4.875rem] lg:pl-[2.625rem] lg:pr-[3.75rem]"
	>
		<h2 class="text-[1.875rem] leading-[1.1] tracking-[-0.03em] md:text-[2.25rem] lg:text-[clamp(2.25rem,2.3vw,2.75rem)]">
			{copy.greeting} {site.name}.
		</h2>
		<div class="mt-6 space-y-[22px] text-[17px] leading-[1.75] text-muted">
			{copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<a
			class="mt-8 inline-flex items-center gap-2 text-[13px] font-medium transition-colors duration-150 hover:text-accent"
			href={contactHref}
		>
			{copy.cta}
			<ArrowIcon class="size-3.5 shrink-0" />
		</a>
	</div>
</section>
