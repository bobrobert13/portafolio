---
import { site, type Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].contact;
const contactEmail = site.contactEmail;
---

<section
	id="contacto"
	class="grid gap-9 border-b border-line px-[1.125rem] py-13 md:px-6 md:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.72fr)] lg:gap-12 lg:px-11 lg:py-13"
>
	<div class="slide-anim">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h2
			class="mt-5 text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
		>
			{copy.title}
		</h2>
		<p class="mt-5 max-w-[600px] text-[17px] leading-[1.7] text-muted">
			{copy.description}
		</p>
		<p
			class="mt-8 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1.5 text-[11px] font-medium"
		>
			<span class="size-[5px] shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
			{copy.badge}
		</p>
		<h3 class="mt-8 text-[1.375rem] leading-[1.2] tracking-[-0.02em]">
			{copy.subheading}
		</h3>
		<p class="mt-2.5 max-w-[560px] text-[15px] leading-[1.7] text-muted">{copy.detail}</p>
		<dl class="mt-6 grid gap-3 border-t border-line pt-5 text-sm sm:grid-cols-2">
			{
				copy.meta.map((entry) => (
					<div>
						<dt class="text-[11px] text-subtle">{entry.label}</dt>
						<dd class="mt-0.5 text-ink/85">{entry.value}</dd>
					</div>
				))
			}
		</dl>
	</div>

	<div
		class="slide-anim flex flex-col border-t border-line pt-6 lg:border-t-0 lg:border-s lg:border-line lg:ps-10 lg:pt-0"
	>
		<p class="eyebrow">{copy.form.eyebrow}</p>
		<p class="mt-3 text-[1.0625rem] leading-[1.5]">{copy.form.lead}</p>

		<form
			class="contact-form"
			data-contact-form
			data-email={contactEmail ?? ''}
			data-status={copy.form.status}
			data-unconfigured={copy.form.unconfigured}
			action={contactEmail ? `mailto:${contactEmail}` : undefined}
			method="post"
			enctype="text/plain"
		>
			<div class="contact-field">
				<label for="contact-name">{copy.form.nameLabel}</label>
				<input
					class="contact-input"
					id="contact-name"
					name="name"
					autocomplete="name"
					placeholder={copy.form.namePlaceholder}
					required
				/>
			</div>
			<div class="contact-field">
				<label for="contact-email">{copy.form.emailLabel}</label>
				<input
					class="contact-input"
					id="contact-email"
					name="email"
					type="email"
					autocomplete="email"
					placeholder={copy.form.emailPlaceholder}
					required
				/>
			</div>
			<div class="contact-field">
				<label for="contact-message">{copy.form.messageLabel}</label>
				<textarea
					class="contact-input"
					id="contact-message"
					name="message"
					placeholder={copy.form.messagePlaceholder}
					required></textarea>
			</div>
			<button class="contact-submit" type="submit">{copy.form.submit}</button>
			<p class="contact-status" data-contact-status aria-live="polite"></p>
		</form>

		{
			contactEmail && (
				<p class="contact-fallback">
					{copy.form.fallbackPrefix}{' '}
					<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
				</p>
			)
		}
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

	if (form) {
		const status = form.querySelector<HTMLElement>('[data-contact-status]');
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const email = form.dataset.email ?? '';
		const statusMessage = form.dataset.status ?? '';
		const unconfigured = form.dataset.unconfigured ?? '';

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			if (!email) {
				if (status) status.textContent = unconfigured;
				return;
			}

			const data = new FormData(form);
			const name = String(data.get('name') ?? '').trim();
			const from = String(data.get('email') ?? '').trim();
			const message = String(data.get('message') ?? '').trim();
			const subject = `Contacto · ${name}`;
			const body = `${message}\n\n— ${name} (${from})`;

			/* EmailJS is not wired yet: compose the email so the form is usable. */
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

			if (status) status.textContent = statusMessage;
			if (button) {
				button.disabled = true;
				window.setTimeout(() => {
					button.disabled = false;
				}, 1600);
			}
		});
	}
</script>

<style>
	.contact-form {
		display: grid;
		gap: 0.6rem;
		width: 100%;
		margin-top: 1rem;
	}

	.contact-field {
		display: grid;
		gap: 0.25rem;
	}

	.contact-field label {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-subtle);
	}

	.contact-input {
		width: 100%;
		min-height: 2.4rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-sm);
		background-color: var(--color-band);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	.contact-input::placeholder {
		color: color-mix(in oklab, var(--color-muted) 70%, transparent);
	}

	.contact-input:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
		border-color: color-mix(in oklab, var(--color-accent) 50%, var(--color-line));
	}

	textarea.contact-input {
		min-height: 4.5rem;
		resize: vertical;
	}

	.contact-submit {
		display: inline-flex;
		min-height: 42px;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1rem;
		border: 1px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
		border-radius: var(--radius-btn);
		background-color: var(--color-accent);
		color: var(--color-accent-ink);
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.4;
		cursor: pointer;
		box-shadow: var(--shadow-btn);
	}

	.contact-submit:hover {
		filter: brightness(1.05);
	}

	.contact-submit:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 3px;
	}

	.contact-submit:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	.contact-status {
		margin: 0;
		font-size: 0.6875rem;
		line-height: 1.5;
		color: var(--color-accent-text);
	}

	.contact-status:empty {
		display: none;
	}

	.contact-fallback {
		margin-top: 0.75rem;
		padding-top: 0.65rem;
		border-top: 1px solid var(--color-line);
		font-size: 0.6875rem;
		line-height: 1.55;
		color: var(--color-subtle);
	}

	.contact-fallback a {
		color: var(--color-accent-text);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (min-width: 1024px) and (max-height: 820px) {
		.contact-form {
			gap: 0.45rem;
			margin-top: 0.75rem;
		}

		.contact-input {
			min-height: 2.1rem;
			padding: 0.4rem 0.55rem;
		}

		textarea.contact-input {
			min-height: 3.2rem;
		}

		.contact-submit {
			min-height: 38px;
			padding: 0.5rem 0.9rem;
		}

		.contact-fallback {
			margin-top: 0.5rem;
			padding-top: 0.5rem;
		}
	}
</style>
