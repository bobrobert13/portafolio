---
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].manifesto;
---

<section
	id="manifiesto"
	class="relative isolate flex flex-col items-center justify-center border-b border-line px-[1.125rem] py-13 md:px-6 md:py-14 lg:px-11 lg:py-19"
>
	<div class="ambient-field" aria-hidden="true">
		<span class="ambient-orb orb-manifesto-a"></span>
		<span class="ambient-orb orb-manifesto-b"></span>
	</div>
	<div class="slide-anim w-full max-w-[64rem] text-center">
		<h2
			data-typing
			aria-label={copy.title}
			class="text-[1.75rem] leading-[1.08] tracking-[-0.03em] md:text-[2.0625rem] lg:text-[clamp(2.5rem,2.6vw,3rem)]"
		>
			<span data-typing-text aria-hidden="true">{copy.title}</span>
		</h2>
		<p class="mx-auto mt-5 max-w-[48rem] text-[1.0625rem] leading-[1.75] text-muted">
			{copy.lead}
		</p>
	</div>

	<div class="manifesto-fan mt-[clamp(2rem,5vh,4rem)] w-full">
		{
			copy.cards.map((card, index) => (
				<article class="manifesto-card" tabindex="0">
					<div class="flex h-full flex-col p-5">
						<div class="flex items-start justify-between gap-3">
							<span class="font-mono text-[10px] text-subtle">
								{String(index + 1).padStart(2, '0')}
							</span>
							<span class="size-[5px] rounded-full bg-accent" aria-hidden="true" />
						</div>
						<p class="mt-4 font-mono text-[clamp(2.5rem,4vw,4rem)] leading-none text-accent/20">
							{String(index + 1).padStart(2, '0')}
						</p>
						<div class="mt-auto">
							<h3 class="text-[1.125rem] leading-[1.2] tracking-[-0.02em]">
								{card.title}
							</h3>
							<p class="mt-2 text-[11px] leading-[1.5] text-muted">{card.detail}</p>
						</div>
					</div>
				</article>
			))
		}
	</div>
</section>

<script>
	const heading = document.querySelector<HTMLElement>('[data-typing]');
	const textNode = heading?.querySelector<HTMLElement>('[data-typing-text]');

	if (heading && textNode) {
		const text = textNode.textContent ?? '';
		const caret = document.createElement('span');
		caret.className =
			'ml-1 inline-block h-[0.9em] w-[0.08em] translate-y-[0.12em] bg-accent align-baseline animate-pulse';
		caret.setAttribute('aria-hidden', 'true');

		heading.classList.add('min-h-[2.2em]');
		textNode.textContent = '';
		textNode.after(caret);

		const type = () => {
			let index = 0;
			const step = () => {
				textNode.textContent = text.slice(0, index);
				index += 1;
				if (index <= text.length) {
					window.setTimeout(step, 38);
				} else {
					window.setTimeout(() => caret.remove(), 1200);
				}
			};
			step();
		};

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				type();
			},
			{ threshold: 0.45 },
		);

		observer.observe(heading);
	}

	const fan = document.querySelector<HTMLElement>('.manifesto-fan');

	if (fan) {
		const cards = Array.from(fan.querySelectorAll<HTMLElement>('.manifesto-card'));

		const setActive = (active: HTMLElement) => {
			for (const card of cards) {
				card.classList.toggle('active', card === active);
				card.classList.toggle('not-active', card !== active);
			}
		};

		const clear = () => {
			for (const card of cards) card.classList.remove('active', 'not-active');
		};

		for (const card of cards) {
			card.addEventListener('mouseenter', () => setActive(card));
			card.addEventListener('mouseleave', clear);
			card.addEventListener('focus', () => setActive(card));
			card.addEventListener('blur', clear);
		}
	}
</script>

<style>
	.manifesto-fan {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		align-items: start;
		justify-items: center;
		width: 100%;
	}

	.manifesto-card {
		position: relative;
		width: 100%;
		max-width: 14rem;
		height: 18rem;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-card, 10px);
		background: var(--color-page);
		cursor: default;
		transform-origin: center;
		transform: scale(var(--s, 1)) rotate(var(--r, 0deg)) translateX(var(--x, 0))
			translateY(var(--y, 0));
		transition:
			transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 200ms ease,
			background-color 200ms ease;
		z-index: var(--z, 1);
	}

	.manifesto-card::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: var(--color-page);
		opacity: 0;
		transition: opacity 300ms ease;
	}

	.manifesto-card:nth-child(1) {
		--s: 0.8;
		--r: -28deg;
		--x: 4rem;
		--y: 7rem;
		--z: 1;
	}

	.manifesto-card:nth-child(2) {
		--s: 0.92;
		--r: -16deg;
		--x: 2rem;
		--y: 3rem;
		--z: 3;
	}

	.manifesto-card:nth-child(3) {
		--s: 1.04;
		--r: -6deg;
		--x: 0.5rem;
		--y: 0;
		--z: 5;
	}

	.manifesto-card:nth-child(4) {
		--s: 1.04;
		--r: 6deg;
		--x: -0.5rem;
		--y: 0;
		--z: 5;
	}

	.manifesto-card:nth-child(5) {
		--s: 0.92;
		--r: 16deg;
		--x: -2rem;
		--y: 3rem;
		--z: 3;
	}

	.manifesto-card:nth-child(6) {
		--s: 0.8;
		--r: 28deg;
		--x: -4rem;
		--y: 7rem;
		--z: 1;
	}

	.manifesto-card.active {
		z-index: 20;
		transform-origin: center top;
		border-color: color-mix(in oklab, var(--color-accent) 38%, transparent);
		background: var(--color-surface);
		transform: scale(1.22) rotate(0deg) translateX(var(--x)) translateY(-0.25rem);
	}

	.manifesto-card.not-active {
		transform: scale(calc(var(--s) - 0.08)) rotate(var(--r)) translateX(var(--x))
			translateY(var(--y));
	}

	.manifesto-card.not-active::after {
		opacity: 0.55;
	}

	.manifesto-card:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	@media (min-width: 1024px) {
		.manifesto-fan {
			padding-bottom: 8rem;
		}
	}

	@media (min-width: 1024px) and (max-height: 820px) {
		#manifiesto {
			padding-top: 3.5rem;
			padding-bottom: 2.5rem;
		}

		#manifiesto .manifesto-fan {
			margin-top: 3rem;
			padding-bottom: 6rem;
		}
	}

	@media (max-width: 1023px) {
		.manifesto-fan {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
			margin-top: 2rem;
		}

		.manifesto-card {
			max-width: none;
			height: auto;
			min-height: 14rem;
			transform: none;
		}

		.manifesto-card.active {
			transform: translateY(-0.25rem);
		}

		.manifesto-card.not-active {
			transform: none;
		}
	}

	@media (max-width: 639px) {
		.manifesto-fan {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* Breathe variant: the fog swells in place behind the card fan. */
	.orb-manifesto-a {
		--orb-size: 0.44;
		--orb-top: 26%;
		--orb-left: 60%;
		--orb-speed: 22s;
		--orb-delay: -10s;
		--orb-opacity: 0.47;
		--orb-path: ambient-breathe;
	}

	.orb-manifesto-b {
		--orb-size: 0.3;
		--orb-top: 52%;
		--orb-left: -8%;
		--orb-speed: 28s;
		--orb-delay: -20s;
		--orb-opacity: 0.38;
		--orb-a: var(--orb-plate);
		--orb-b: var(--orb-accent);
		--orb-path: ambient-breathe;
	}
</style>
