---
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].manifesto;
---

<section
	id="manifiesto"
	class="relative isolate flex flex-col justify-center border-b border-line px-[1.125rem] py-13 md:px-6 md:py-14 lg:px-11 lg:py-19"
>
	<div class="ambient-field" aria-hidden="true">
		<span class="ambient-orb orb-manifesto-a"></span>
		<span class="ambient-orb orb-manifesto-b"></span>
	</div>

	<div class="slide-anim manifesto mx-auto w-full max-w-[80rem]" data-manifesto>
		<header class="manifesto-head">
			<div>
				<p class="eyebrow">{copy.eyebrow}</p>
				<h2 class="manifesto-title">{copy.title}</h2>
			</div>
			<p class="manifesto-lead">{copy.lead}</p>
		</header>

		<div class="manifesto-spine">
			<span class="manifesto-axis" aria-hidden="true"></span>
			<span class="manifesto-pulse" aria-hidden="true"></span>

			<ul class="manifesto-list" role="list">
				{
					copy.cards.map((card, index) => (
						<li class="manifesto-station" style={`--i:${index}`}>
							{index % 2 === 0 && (
								<div class="manifesto-copy left">
									<span class="manifesto-word">{card.title}</span>
									<p class="manifesto-detail">{card.detail}</p>
								</div>
							)}
							<span class="manifesto-branch" aria-hidden="true" />
							<span class="manifesto-dot" aria-hidden="true" />
							{index % 2 === 1 && (
								<div class="manifesto-copy right">
									<span class="manifesto-word">{card.title}</span>
									<p class="manifesto-detail">{card.detail}</p>
								</div>
							)}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	const manifesto = document.querySelector<HTMLElement>('[data-manifesto]');

	if (manifesto && 'IntersectionObserver' in window) {
		/* `is-animated` hides the pieces; `is-visible` releases the cascade.
		   Without the observer the manifesto is simply there. */
		manifesto.classList.add('is-animated');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.25 },
		);

		observer.observe(manifesto);
	}
</script>

<style>
	.manifesto {
		/* The spine reads a step darker than a hairline: it is structure. */
		--manifesto-line: color-mix(in oklab, var(--color-subtle) 55%, transparent);
	}

	.manifesto-head {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: end;
		gap: clamp(1.5rem, 3vw, 3rem);
	}

	.manifesto-title {
		margin: 0.9rem 0 0;
		max-width: 16ch;
		font-size: clamp(1.875rem, 3.1vw, 3.5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.038em;
		text-wrap: balance;
	}

	.manifesto-lead {
		margin: 0;
		max-width: 40ch;
		font-size: 0.9375rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	/* The axis is the line that draws; every station hangs off it. */
	.manifesto-spine {
		position: relative;
		margin-top: clamp(1.75rem, 4vw, 2.75rem);
	}

	.manifesto-axis {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		background-color: var(--manifesto-line);
		transform-origin: top;
	}

	.manifesto-pulse {
		position: absolute;
		top: 0;
		left: 50%;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background-color: var(--color-accent);
		translate: -50% 0;
		animation: manifesto-pulse 3.2s linear infinite;
	}

	.manifesto-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.manifesto-station {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 1.75rem minmax(0, 1fr);
		align-items: start;
		padding-block: 0.7rem;
	}

	.manifesto-copy.left {
		grid-column: 1;
		grid-row: 1;
		padding-right: 1.25rem;
		text-align: right;
	}

	.manifesto-copy.right {
		grid-column: 3;
		grid-row: 1;
		padding-left: 1.25rem;
	}

	.manifesto-branch {
		grid-column: 2;
		grid-row: 1;
		width: 100%;
		height: 1px;
		margin-top: 0.6rem;
		background-image: repeating-linear-gradient(
			to right,
			var(--manifesto-line) 0 4px,
			transparent 4px 7px
		);
	}

	.manifesto-dot {
		grid-column: 2;
		grid-row: 1;
		justify-self: center;
		width: 6px;
		height: 6px;
		margin-top: 0.4rem;
		border-radius: 50%;
		background-color: var(--color-accent);
		z-index: 1;
	}

	.manifesto-word {
		display: block;
		font-size: clamp(1.15rem, 1.7vw, 1.55rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.manifesto-detail {
		margin: 0.2rem 0 0;
		font-size: 0.6875rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	@keyframes manifesto-pulse {
		0% {
			top: 0;
			opacity: 0;
		}
		12% {
			opacity: 1;
		}
		88% {
			opacity: 1;
		}
		100% {
			top: 100%;
			opacity: 0;
		}
	}

	/*
	 * Entry cascade. `is-animated` is only added once the observer exists, so
	 * without JavaScript the manifesto is visible. Each station keeps its own
	 * `--i`, so lines, dots and text arrive one after another.
	 */
	.manifesto.is-animated .manifesto-copy {
		opacity: 0;
		translate: 0 0.75rem;
	}

	.manifesto.is-animated .manifesto-dot {
		opacity: 0;
		scale: 0.4;
	}

	.manifesto.is-animated .manifesto-branch {
		opacity: 0;
	}

	.manifesto.is-animated .manifesto-axis {
		transform: scaleY(0);
	}

	.manifesto.is-animated.is-visible .manifesto-copy {
		opacity: 1;
		translate: 0 0;
		transition:
			opacity 620ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms),
			translate 620ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms);
	}

	.manifesto.is-animated.is-visible .manifesto-dot {
		opacity: 1;
		scale: 1;
		transition:
			opacity 320ms ease calc(120ms + var(--i, 0) * 90ms),
			scale 320ms cubic-bezier(0.16, 1, 0.3, 1) calc(120ms + var(--i, 0) * 90ms);
	}

	.manifesto.is-animated.is-visible .manifesto-branch {
		opacity: 1;
		transition: opacity 420ms ease calc(180ms + var(--i, 0) * 90ms);
	}

	.manifesto.is-animated.is-visible .manifesto-axis {
		transform: scaleY(1);
		transition: transform 1000ms cubic-bezier(0.2, 0.8, 0.2, 1) 60ms;
	}

	/* The sheet pauses its ambient loops while offstage; the pulse follows. */
	:global(.slide.is-offstage) .manifesto-pulse {
		animation-play-state: paused;
	}

	@media (max-width: 899px) {
		.manifesto-head {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}

		.manifesto-axis {
			left: 0.3rem;
		}

		.manifesto-station {
			grid-template-columns: 1.1rem minmax(0, 1fr);
		}

		.manifesto-copy.left,
		.manifesto-copy.right {
			grid-column: 2;
			grid-row: 1;
			padding: 0;
			text-align: left;
		}

		.manifesto-branch {
			display: none;
		}

		.manifesto-dot {
			grid-column: 1;
			grid-row: 1;
			justify-self: start;
			margin-top: 0.45rem;
		}
	}

	/* Shorter laptops: tighten the stations so six fit on one screen. */
	@media (min-width: 1024px) and (max-height: 820px) {
		.manifesto-spine {
			margin-top: 1.5rem;
		}

		.manifesto-station {
			padding-block: 0.45rem;
		}
	}

	/* The site keeps its motion here; reduced motion removes displacement
	   and scale, the manifesto still fades in on the same cascade. */
	@media (prefers-reduced-motion: reduce) {
		.manifesto-pulse {
			display: none;
		}

		.manifesto.is-animated .manifesto-copy {
			translate: none;
		}

		.manifesto.is-animated .manifesto-dot {
			scale: 1;
		}
	}

	/* Breathe variant: the fog swells in place behind the spine. */
	.orb-manifesto-a {
		--orb-size: 0.44;
		--orb-top: 26%;
		--orb-left: 60%;
		--orb-speed: 22s;
		--orb-delay: -10s;
		--orb-opacity: 0.47;
		--orb-path: ambient-breathe;
	}

	.orb-manifesto-b {
		--orb-size: 0.3;
		--orb-top: 52%;
		--orb-left: -8%;
		--orb-speed: 28s;
		--orb-delay: -20s;
		--orb-opacity: 0.38;
		--orb-a: var(--orb-plate);
		--orb-b: var(--orb-accent);
		--orb-path: ambient-breathe;
	}
</style>
