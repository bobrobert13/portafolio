---
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].tools;
---

<section id="herramientas" class="relative isolate bg-band border-b border-line">
	<div class="ambient-field" aria-hidden="true">
		<span class="ambient-orb orb-tools-a"></span>
		<span class="ambient-orb orb-tools-b"></span>
	</div>
	<div
		class="slide-anim grid items-center gap-9 px-[1.125rem] py-13 md:px-6 md:py-14 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-12 lg:px-11 lg:py-19"
	>
		<div class="max-w-[36rem]">
			<p class="eyebrow">{copy.eyebrow}</p>
			<h2
				class="mt-4 text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
			>
				{copy.title}
			</h2>
			<p class="mt-4 max-w-[600px] text-base leading-[1.7] text-muted md:mt-5 md:text-[17px]">
				{copy.description}
			</p>
		</div>

		<div class="kit-grid" data-kit-grid>
			{
				copy.groups.map((group, index) => (
					<article
						class:list={['kit-tile', index === 3 && 'is-featured']}
						style={`--tile-index: ${index}`}
					>
						<div class="kit-tile-inner flex h-full flex-col border border-line bg-page p-4">
							<div class="flex items-start justify-between gap-3">
								<span class="font-mono text-[10px] text-subtle">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="mt-1 size-[5px] rounded-full bg-accent" aria-hidden="true" />
							</div>
							<p class="mt-2 text-[1.25rem] leading-[1.15] tracking-[-0.02em]">
								{group.title}
							</p>
							<p class="mt-1.5 text-[11px] leading-[1.5] text-muted">{group.note}</p>
							<ul class="mt-auto flex flex-wrap gap-1.5 pt-3">
								{group.items.map((item) => (
									<li class="rounded-xs border border-line bg-ink/[0.03] px-1.5 py-0.5 font-mono text-[9px] leading-normal text-muted">
										{item}
									</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-kit-grid]'));
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add('is-playing');
				observer.unobserve(entry.target);
			}
		},
		{ threshold: 0.15 },
	);

	/* `is-ready` hides the tiles so the staggered entrance has somewhere to come
	   from; the observer swaps it for `is-playing` once the grid is on screen. */
	for (const grid of grids) {
		grid.classList.add('is-ready');
		observer.observe(grid);
	}
</script>

<style>
	.kit-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.65rem;
	}

	.kit-tile {
		min-height: 12rem;
	}

	.kit-tile-inner {
		height: 100%;
		transition:
			border-color 180ms ease,
			background-color 180ms ease;
	}

	.kit-tile.is-featured .kit-tile-inner {
		border-color: color-mix(in oklab, var(--color-accent) 34%, transparent);
		background:
			linear-gradient(
				150deg,
				color-mix(in oklab, var(--color-accent) 8%, transparent),
				transparent 62%
			),
			var(--color-page);
	}

	.kit-grid.is-ready .kit-tile-inner {
		opacity: 0;
	}

	.kit-grid.is-playing .kit-tile-inner {
		animation: kit-enter 620ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
		animation-delay: calc(var(--tile-index, 0) * 80ms);
	}

	@keyframes kit-enter {
		from {
			opacity: 0;
			transform: translateY(1.25rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.kit-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.kit-grid {
			display: block;
			position: relative;
			min-height: 27rem;
		}
		.kit-tile {
			position: absolute;
			width: 31%;
			height: 12.5rem;
			min-height: 0;
		}

		.kit-tile:nth-child(1) {
			left: 0;
			top: 2.75rem;
		}

		.kit-tile:nth-child(2) {
			left: 0;
			bottom: -1.5rem;
		}

		.kit-tile:nth-child(3) {
			left: 50%;
			transform: translateX(-50%);
			top: 0;
		}

		.kit-tile:nth-child(4) {
			left: 50%;
			transform: translateX(-50%);
			bottom: 1.5rem;
		}

		.kit-tile:nth-child(5) {
			right: 0;
			top: 1.5rem;
		}

		.kit-tile:nth-child(6) {
			right: 0;
			bottom: 0;
		}
	}

	/* Sweep variant: the band light travels sideways under the kit grid. */
	.orb-tools-a {
		--orb-size: 0.5;
		--orb-top: 52%;
		--orb-left: -12%;
		--orb-speed: 24s;
		--orb-delay: -8s;
		--orb-opacity: 0.47;
		--orb-a: var(--orb-plate);
		--orb-b: var(--orb-accent);
		--orb-path: ambient-drift;
	}

	.orb-tools-b {
		--orb-size: 0.28;
		--orb-top: -14%;
		--orb-left: 56%;
		--orb-speed: 32s;
		--orb-delay: -30s;
		--orb-opacity: 0.34;
		--orb-path: ambient-drift;
	}
</style>
