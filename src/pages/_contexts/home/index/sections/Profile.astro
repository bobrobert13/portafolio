---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import { site, type Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang];
const about = copy.about;
const profile = copy.profile;
const contactHref = site.contactEmail
	? `mailto:${site.contactEmail}`
	: '#perfil-contacto';
const socials = [
	{ label: profile.linkedin, href: site.socials.linkedin },
	{ label: profile.github, href: site.socials.github },
];
---

<section
	id="perfil"
	class="grid border-b border-line lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]"
>
	<div class="rail-anim rail-media relative min-h-[360px] overflow-hidden lg:min-h-[465px]">
		<div
			class="absolute inset-0 bg-[radial-gradient(at_35%_80%,color-mix(in_oklab,var(--color-accent)_28%,transparent),transparent_70%)]"
			aria-hidden="true"
		>
		</div>
		<img
			src="/img/portrait-placeholder.jpg"
			alt=""
			width="1200"
			height="1800"
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-[center_25%] grayscale [mask-image:linear-gradient(#000_78%,transparent_100%)]"
		/>
	</div>

	<div
		class="rail-anim px-[1.125rem] py-14 md:px-9 lg:max-w-[52rem] lg:py-[4.875rem] lg:pl-[2.625rem] lg:pr-[3.75rem]"
	>
		<p class="eyebrow">{profile.eyebrow}</p>
		<h2
			class="mt-5 text-[1.875rem] leading-[1.1] tracking-[-0.03em] md:text-[2.25rem] lg:text-[clamp(2.25rem,2.3vw,2.75rem)]"
		>
			{about.greeting} {site.name}.
		</h2>
		<div class="mt-6 space-y-[22px] text-[17px] leading-[1.75] text-muted">
			{about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<div id="perfil-contacto" class="profile-contact mt-8 border-t border-line pt-6">
			<p class="eyebrow">{profile.contactEyebrow}</p>
			<p class="mt-3 max-w-[34rem] text-[15px] leading-[1.7] text-muted">
				{profile.contactLead}
			</p>
			<div class="mt-4 flex flex-wrap gap-2">
				{
					site.contactEmail && (
						<a
							class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/5 px-3.5 py-2 text-[12px] font-medium text-accent transition-colors duration-150 hover:border-accent/50 hover:bg-accent/10"
							href={contactHref}
						>
							{profile.emailLabel}
							<ArrowIcon class="size-3.5 shrink-0" />
						</a>
					)
				}
				{
					socials.map((social) => (
						<a
							class="inline-flex items-center gap-2 rounded-full border border-line px-3.5 py-2 text-[12px] font-medium text-ink/80 transition-colors duration-150 hover:border-accent/30 hover:bg-accent/5 hover:text-accent"
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							{social.label}
							<ArrowIcon direction="up-right" class="size-3.5 shrink-0" />
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>
