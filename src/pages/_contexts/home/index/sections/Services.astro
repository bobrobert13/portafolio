---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import BaseButton from '@/infra/components/BaseButton.vue';
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].services;
const specimens = copy.specimens;
---

<section id="servicios" class="relative isolate bg-band border-b border-line">
	<div class="ambient-field" aria-hidden="true">
		<span class="ambient-orb orb-services"></span>
	</div>

	<div
		class="slide-anim flex flex-col items-start gap-6 px-[1.125rem] pt-13 pb-[1.875rem] md:px-6 md:pt-14 lg:flex-row lg:items-end lg:justify-between lg:px-11 lg:pt-19 lg:pb-9.5"
	>
		<div class="max-w-[672px]">
			<h2
				class="text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
			>
				{copy.title}
			</h2>
			<p class="mt-4 max-w-[600px] text-base leading-[1.7] text-muted md:mt-5 md:text-[17px]">
				{copy.description}
			</p>
		</div>
		<BaseButton href="#construccion" variant="ghost">
			{copy.cta}
			<ArrowIcon slot="trailing" class="size-4 shrink-0" />
		</BaseButton>
	</div>

	<div class="slide-anim px-[1.125rem] pb-12 md:px-6 lg:px-11 lg:pb-14">
		<div class="service-tabs" role="radiogroup" aria-label={copy.tabsLabel}>
			{
				copy.items.map((item, index) => (
					<>
						<input
							class="service-radio"
							type="radio"
							name="service"
							id={`service-${item.slug}`}
							checked={index === 0}
						/>
						<label class="service-tab" for={`service-${item.slug}`}>
							<span class="service-tab-number">{item.number}</span>
							<span>{item.title}</span>
						</label>
					</>
				))
			}
		</div>

		<div class="service-panels">
			{
				copy.items.map((item) => (
					<article
						class="service-panel"
						id={`panel-${item.slug}`}
						aria-labelledby={`service-title-${item.slug}`}
					>
						<div class="max-w-[42rem]">
							<h3
								id={`service-title-${item.slug}`}
								class="text-[1.5rem] font-medium leading-[1.15] tracking-[-0.025em]"
							>
								{item.title}
							</h3>
							<p class="mt-2 text-[0.8125rem] leading-[1.65] text-muted">
								{item.description}
							</p>
							<ul class="mt-3 flex flex-wrap gap-1.5" role="list">
								{item.tags.map((tag) => (
									<li class="rounded-xs border border-line bg-ink/[0.03] px-2 py-0.5 font-mono text-[0.625rem] leading-normal text-muted">
										{tag}
									</li>
								))}
							</ul>
						</div>

						<div class="service-artifact">
							{item.specimen === 'build' && (
								<>
									<p class="service-art-label">{specimens.build.label}</p>
									<pre class="service-code">{specimens.build.lines.join('\n')}</pre>
									<p class="service-art-note">{specimens.build.note}</p>
								</>
							)}

							{item.specimen === 'scale' && (
								<>
									<p class="service-art-label">{specimens.scale.label}</p>
									<div class="service-scale">
										{specimens.scale.rows.map((row) => (
											<div class="service-scale-row">
												<span>{row.meta}</span>
												<b>{row.sample}</b>
											</div>
										))}
									</div>
									<p class="service-art-note">{specimens.scale.note}</p>
								</>
							)}

							{item.specimen === 'focus' && (
								<>
									<p class="service-art-label">{specimens.focus.label}</p>
									<div class="flex flex-wrap items-center gap-3">
										<a class="service-focus-link" href="#contacto">
											{specimens.focus.action}
											<ArrowIcon class="size-3.5 shrink-0" />
										</a>
										<span class="text-[0.6875rem] leading-[1.5] text-muted">
											{specimens.focus.hint}
										</span>
									</div>
									<ul class="mt-4 grid gap-2" role="list">
										{specimens.focus.swatches.map((swatch) => (
											<li class="flex items-center gap-2 font-mono text-[0.5625rem] text-muted">
												<span
													class:list={[
														'size-6 shrink-0 rounded-xs',
														swatch.tone === 'accent' ? 'bg-accent' : 'bg-accent-text',
													]}
													aria-hidden="true"
												/>
												{swatch.label}
											</li>
										))}
									</ul>
								</>
							)}

							{item.specimen === 'payload' && (
								<>
									<p class="service-art-label">{specimens.payload.label}</p>
									<div class="grid grid-cols-3 gap-3">
										{specimens.payload.stats.map((stat) => (
											<div>
												<b class="block font-mono text-[1.5rem] font-normal leading-none">
													{stat.value}
												</b>
												<span class="mt-1 block text-[0.625rem] leading-[1.4] text-muted">
													{stat.label}
												</span>
											</div>
										))}
									</div>
									<p class="service-art-note">{specimens.payload.note}</p>
								</>
							)}

							{item.specimen === 'seo' && (
								<>
									<p class="service-art-label">{specimens.seo.label}</p>
									<pre class="service-code">{specimens.seo.lines.join('\n')}</pre>
								</>
							)}

							{item.specimen === 'docs' && (
								<>
									<p class="service-art-label">{specimens.docs.label}</p>
									<ul class="grid gap-1.5" role="list">
										{specimens.docs.files.map((file) => (
											<li class="flex justify-between gap-4 border-b border-line/60 pb-1.5 text-[0.6875rem]">
												<code class="font-mono text-ink">{file.name}</code>
												<span class="text-right text-muted">{file.role}</span>
											</li>
										))}
									</ul>
								</>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Muestrario: a radio group drives which specimen is shown, so the switch
	   works without JavaScript and the panel never depends on it. */
	.service-tabs {
		position: relative;
		display: flex;
		gap: 0.25rem;
		overflow-x: auto;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid var(--color-line);
		scrollbar-width: none;
	}

	.service-tabs::-webkit-scrollbar {
		display: none;
	}

	.service-radio {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		margin: 0;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.service-tab {
		display: inline-flex;
		flex: none;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.45rem 0.65rem;
		border-bottom: 2px solid transparent;
		border-radius: 6px 6px 0 0;
		color: var(--color-muted);
		font-size: 0.75rem;
		line-height: 1.3;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			color 150ms ease;
	}

	.service-tab:hover {
		background: color-mix(in oklab, var(--color-surface) 55%, transparent);
	}

	.service-tab-number {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		color: var(--color-subtle);
	}

	.service-radio:checked + .service-tab {
		border-bottom-color: var(--color-accent);
		background: var(--color-surface);
		color: var(--color-ink);
	}

	.service-radio:focus-visible + .service-tab {
		outline: 2px solid var(--color-focus);
		outline-offset: -2px;
	}

	.service-panels {
		display: grid;
		margin-top: 1.1rem;
	}

	.service-panel {
		display: none;
		gap: 1.5rem;
	}

	/* One rule per service: adding one means adding its slug here. */
	#servicios:has(#service-static:checked) #panel-static,
	#servicios:has(#service-interface:checked) #panel-interface,
	#servicios:has(#service-a11y:checked) #panel-a11y,
	#servicios:has(#service-performance:checked) #panel-performance,
	#servicios:has(#service-seo:checked) #panel-seo,
	#servicios:has(#service-maintenance:checked) #panel-maintenance {
		display: grid;
	}

	.service-artifact {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 14rem;
		padding: 1rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-sm);
		background: var(--color-page);
	}

	.service-art-label {
		margin: 0 0 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-subtle);
	}

	.service-code {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1.75;
		color: var(--color-ink);
		white-space: pre-wrap;
	}

	.service-art-note {
		margin: 0.6rem 0 0;
		font-size: 0.6875rem;
		line-height: 1.55;
		color: var(--color-muted);
	}

	.service-scale {
		display: grid;
		gap: 0.55rem;
	}

	.service-scale-row {
		display: grid;
		grid-template-columns: 5.2rem minmax(0, 1fr);
		align-items: baseline;
		gap: 0.7rem;
	}

	.service-scale-row span {
		font-family: var(--font-mono);
		font-size: 0.5rem;
		line-height: 1.4;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
	}

	.service-scale-row b {
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.service-scale-row:nth-child(1) b {
		font-size: 2.6875rem;
		line-height: 1;
	}

	.service-scale-row:nth-child(2) b {
		font-size: 1.875rem;
		line-height: 1.05;
	}

	.service-scale-row:nth-child(3) b {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-subtle);
	}

	.service-focus-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-btn);
		color: var(--color-ink);
		font-size: 0.8125rem;
		text-decoration: none;
		transition:
			border-color 150ms ease,
			background-color 150ms ease;
	}

	.service-focus-link:hover {
		border-color: color-mix(in oklab, var(--color-ink) 25%, var(--color-line));
		background: color-mix(in oklab, var(--color-ink) 5%, transparent);
	}

	@media (min-width: 900px) {
		.service-panel {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			gap: clamp(1.5rem, 3vw, 2.5rem);
		}
	}
</style>
