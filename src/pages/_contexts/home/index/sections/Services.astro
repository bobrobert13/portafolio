---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import BaseButton from '@/infra/components/BaseButton.vue';
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].services;
---

<section id="servicios" class="relative isolate bg-band border-b border-line">
	<div class="ambient-field" aria-hidden="true">
		<span class="ambient-orb orb-services"></span>
	</div>
	<div
		class="slide-anim flex flex-col items-start gap-6 px-[1.125rem] pt-13 pb-[1.875rem] md:px-6 md:pt-14 lg:flex-row lg:items-end lg:justify-between lg:px-11 lg:pt-19 lg:pb-9.5"
	>
		<div class="max-w-[672px]">
			<h2
				class="text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
			>
				{copy.title}
			</h2>
			<p class="mt-4 max-w-[600px] text-base leading-[1.7] text-muted md:mt-5 md:text-[17px]">
				{copy.description}
			</p>
		</div>
		<BaseButton href="#construccion" variant="ghost">
			{copy.cta}
			<ArrowIcon slot="trailing" class="size-4 shrink-0" />
		</BaseButton>
	</div>

	<div class="slide-anim px-[1.125rem] pb-13 md:px-6 md:pb-16 lg:px-11 lg:pb-17">
		<div
			class="grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-2 lg:grid-cols-3"
		>
			{
				copy.items.map((item, index) => (
					<article class="service-card flex min-h-[230px] flex-col items-start bg-page p-6 md:min-h-[250px] md:px-6 md:pt-[1.5625rem] md:pb-6">
						<h3 class="flex w-full items-baseline gap-2.5 text-[clamp(1.125rem,1.4vw,1.25rem)] leading-[1.2] tracking-[-0.02em]">
							<span
								class:list={[
									'font-mono text-[0.6875rem] font-normal',
									index === 0 ? 'text-accent-text' : 'text-subtle',
								]}
							>
								{item.number}
							</span>
							{item.title}
						</h3>
						<p class="mt-3 text-sm leading-[1.6] text-muted">{item.description}</p>
						<ul class="my-5 flex flex-wrap gap-1.5">
							{item.tags.map((tag) => (
								<li class="rounded-xs border border-line bg-ink/[0.03] px-2.5 py-[5px] font-mono text-[0.6875rem] leading-normal text-muted">
									{tag}
								</li>
							))}
						</ul>
						<a
							href="#contacto"
							class:list={[
								'mt-auto flex w-full items-center justify-between gap-2 rounded-sm border px-3 py-2.5 font-mono text-[0.6875rem] leading-normal transition-colors duration-150',
								index === 0
									? 'border-accent/25 bg-accent/5 text-accent-text hover:border-accent/45 hover:bg-accent/10'
									: 'border-line text-ink/80 hover:border-accent/30 hover:bg-accent/5',
							]}
						>
							{item.title}
							<ArrowIcon class="size-3.5 shrink-0" />
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Rise variant: the band light floats in the header corner, away from the
	   copy and behind the card grid. */
	.orb-services {
		--orb-size: 0.46;
		--orb-top: -18%;
		--orb-left: 58%;
		--orb-speed: 24s;
		--orb-delay: -12s;
		--orb-opacity: 0.46;
		--orb-path: ambient-rise;
	}
</style>
