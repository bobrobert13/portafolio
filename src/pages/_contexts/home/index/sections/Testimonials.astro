---
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].testimonials;
---

<section
	id="experiencias"
	class="bg-band border-b border-line px-[1.125rem] pt-12 pb-7.5 md:px-6 md:pt-16 md:pb-[1.875rem] lg:px-11"
>
	<p class="rail-anim eyebrow">{copy.eyebrow}</p>

	<div
		class="rail-anim mt-8 grid gap-px overflow-hidden rounded-sm border border-line bg-line lg:grid-cols-3"
	>
		{
			copy.items.map((item) => (
				<figure class="flex min-h-[236px] flex-col bg-page p-7">
					<figcaption class="font-mono text-[10px] text-subtle">{item.label}</figcaption>
					<blockquote class="my-5 text-[1.25rem] leading-[1.4] tracking-[-0.02em] text-ink/85 md:mb-6.5">
						{item.quote}
					</blockquote>
					<div class="mt-auto flex items-center gap-3 text-xs text-subtle">
						<span
							class="grid size-8 shrink-0 place-items-center rounded-full border border-dashed border-line"
							aria-hidden="true"
						>
							—
						</span>
						<span>{item.author}</span>
					</div>
				</figure>
			))
		}
	</div>

	<div class="rail-anim mt-8 flex flex-col items-start gap-5 pt-6 md:flex-row md:items-center md:gap-8">
		<p class="eyebrow shrink-0">{copy.stackLabel}</p>
		<ul class="flex w-full flex-wrap items-center gap-x-7 gap-y-3 md:justify-between">
			{
				copy.stack.map((tool) => (
					<li class="text-[1.125rem] font-semibold tracking-[-0.04em] text-subtle">{tool}</li>
				))
			}
		</ul>
	</div>
</section>
