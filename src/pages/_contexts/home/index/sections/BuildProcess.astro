---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import BaseButton from '@/infra/components/BaseButton.vue';
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].process;
const contactHref = '#perfil-contacto';
---

<section id="construccion" class="border-b border-line">
	<div
		class="process-head slide-anim flex flex-col items-start gap-6 px-[1.125rem] pt-13 pb-[1.875rem] md:px-6 md:pt-14 lg:flex-row lg:items-end lg:justify-between lg:px-11 lg:pt-19 lg:pb-9.5"
	>
		<div class="max-w-[672px]">
			<h2
				class="text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
			>
				{copy.title}
			</h2>
			<p class="mt-4 max-w-[600px] text-base leading-[1.7] text-muted md:mt-5 md:text-[17px]">
				{copy.description}
			</p>
		</div>
		<BaseButton href={contactHref} variant="ghost">
			{copy.cta}
			<ArrowIcon slot="trailing" class="size-4 shrink-0" />
		</BaseButton>
	</div>

	<div data-process class="process-body slide-anim px-[1.125rem] pb-12 md:px-6 lg:px-11 lg:pb-17">
		{
			copy.rows.map((row) => (
				<div class="process-row grid gap-6 py-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:py-8.5">
					<div>
						<p class="eyebrow flex items-center gap-2">
							<span
								class="process-dot size-[5px] shrink-0 rounded-full bg-accent"
								aria-hidden="true"
							/>
							{row.eyebrow}
						</p>
						<h3 class="mt-4 text-[1.375rem] leading-[1.2] tracking-[-0.02em]">{row.title}</h3>
						<a
							class="mt-5 inline-flex items-center gap-2 text-[13px] font-medium transition-colors duration-150 hover:text-accent-text"
							href={contactHref}
						>
							{copy.linkLabel}
							<ArrowIcon class="size-3.5 shrink-0" />
						</a>
					</div>
					<ul class="self-center divide-y divide-line">
						{row.items.map((item) => (
							<li class="process-item grid grid-cols-[78px_1fr] items-baseline gap-3 py-3.5 text-sm">
								<span class="font-mono text-[10px] text-subtle">{item.kind}</span>
								<span class="text-ink/85">{item.label}</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<script>
	const body = document.querySelector<HTMLElement>('[data-process]');

	if (body && 'IntersectionObserver' in window) {
		const rows = Array.from(body.querySelectorAll<HTMLElement>('.process-row'));

		body.classList.add('is-animated');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-drawn');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.35 },
		);

		for (const row of rows) observer.observe(row);
	}
</script>

<style>
	/*
	 * Process rules draw in as each row enters: the structural line of the
	 * section carries the motion, not more text. Without JS the rules stay
	 * visible; `is-animated` is only added once the observer can run.
	 */
	.process-row {
		position: relative;
	}

	.process-row::before {
		content: '';
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 1px;
		background-color: var(--color-line);
		transform-origin: left center;
	}

	.process-dot {
		transform-origin: center;
	}

	.process-body.is-animated .process-row::before {
		transform: scaleX(0);
	}

	.process-body.is-animated .process-row .process-dot {
		opacity: 0;
		transform: scale(0.2);
	}

	.process-body.is-animated .process-row.is-drawn::before {
		animation: process-line 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.process-body.is-animated .process-row.is-drawn .process-dot {
		animation: process-dot 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.process-body.is-animated .process-row:nth-child(2).is-drawn::before,
	.process-body.is-animated .process-row:nth-child(2).is-drawn .process-dot {
		animation-delay: 90ms;
	}

	.process-body.is-animated .process-row:nth-child(3).is-drawn::before,
	.process-body.is-animated .process-row:nth-child(3).is-drawn .process-dot {
		animation-delay: 180ms;
	}

	.process-body.is-animated .process-row:nth-child(4).is-drawn::before,
	.process-body.is-animated .process-row:nth-child(4).is-drawn .process-dot {
		animation-delay: 270ms;
	}

	@keyframes process-line {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	@keyframes process-dot {
		from {
			opacity: 0;
			transform: scale(0.2);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
