---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import BaseButton from '@/infra/components/BaseButton.vue';
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].process;
const contactHref = '#contacto';
---

<section id="construccion" class="border-b border-line">
	<div
		class="process-head slide-anim flex flex-col items-start gap-6 px-[1.125rem] pt-13 pb-[1.875rem] md:px-6 md:pt-14 lg:flex-row lg:items-end lg:justify-between lg:px-11 lg:pt-19 lg:pb-9.5"
	>
		<div class="max-w-[672px]">
			<h2
				class="text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
			>
				{copy.title}
			</h2>
			<p class="mt-4 max-w-[600px] text-base leading-[1.7] text-muted md:mt-5 md:text-[17px]">
				{copy.description}
			</p>
		</div>
		<BaseButton href={contactHref} variant="ghost">
			{copy.cta}
			<ArrowIcon slot="trailing" class="size-4 shrink-0" />
		</BaseButton>
	</div>

	<div class="process-body slide-anim px-[1.125rem] pb-12 md:px-6 lg:px-11 lg:pb-17">
		<div class="process-conv" data-process>
			<ol class="conv-list">
				{
					copy.rows.map((row, index) => (
						<li class="conv-row" style={`--i:${index}`}>
							<div class="conv-top">
								<h3 class="conv-verb">{row.title}</h3>
								<span class="conv-give">{row.give}</span>
							</div>
							<div class="conv-sides">
								<div class="conv-side">
									<p class="eyebrow">{copy.youLabel}</p>
									<p>{row.you}</p>
								</div>
								<div class="conv-side">
									<p class="eyebrow">{copy.meLabel}</p>
									<p>{row.me}</p>
								</div>
							</div>
						</li>
					))
				}
			</ol>

			<p class="conv-closing">
				<strong>{copy.closing.lead}</strong>
				{copy.closing.tail}
			</p>
		</div>
	</div>
</section>

<script>
	const process = document.querySelector<HTMLElement>('[data-process]');

	if (process && 'IntersectionObserver' in window) {
		/* `is-animated` hides the rows; `is-visible` releases the cascade.
		   Without the observer the four conversations are simply there. */
		process.classList.add('is-animated');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.25 },
		);

		observer.observe(process);
	}
</script>

<style>
	.conv-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
	}

	.conv-row {
		position: relative;
		padding-block: 0.85rem;
	}

	/* The rule is the phase divider and the line that draws on entry. */
	.conv-row::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: var(--color-line);
		transform-origin: left;
	}

	.conv-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.conv-verb {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.conv-give {
		flex: none;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		line-height: 1.4;
		letter-spacing: 0.04em;
		color: var(--color-accent-text);
		white-space: nowrap;
	}

	.conv-sides {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		margin-top: 0.5rem;
	}

	.conv-side {
		padding-block: 0.15rem;
	}

	.conv-side:first-child {
		padding-inline-end: 1.25rem;
	}

	.conv-side + .conv-side {
		padding-inline-start: 1.25rem;
		border-inline-start: 1px solid var(--color-line);
	}

	.conv-side p:last-child {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.conv-closing {
		margin: 1.5rem 0 0;
		padding-top: 1.25rem;
		max-width: 44rem;
		border-top: 1px solid var(--color-line);
		font-size: 1.25rem;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.conv-closing strong {
		font-weight: 500;
		color: var(--color-accent-text);
	}

	/* Entry cascade: the rule draws, then the row arrives. */
	.process-conv.is-animated .conv-row,
	.process-conv.is-animated .conv-closing {
		opacity: 0;
		translate: 0 0.75rem;
	}

	.process-conv.is-animated .conv-row::before {
		transform: scaleX(0);
	}

	.process-conv.is-animated.is-visible .conv-row {
		opacity: 1;
		translate: 0 0;
		transition:
			opacity 620ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms),
			translate 620ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 90ms);
	}

	.process-conv.is-animated.is-visible .conv-row::before {
		transform: scaleX(1);
		transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1)
			calc(var(--i, 0) * 90ms);
	}

	.process-conv.is-animated.is-visible .conv-closing {
		opacity: 1;
		translate: 0 0;
		transition:
			opacity 620ms cubic-bezier(0.16, 1, 0.3, 1) 420ms,
			translate 620ms cubic-bezier(0.16, 1, 0.3, 1) 420ms;
	}

	@media (max-width: 899px) {
		.conv-sides {
			grid-template-columns: minmax(0, 1fr);
		}

		.conv-side:first-child {
			padding-inline-end: 0;
		}

		.conv-side + .conv-side {
			margin-top: 0.5rem;
			padding-inline-start: 0;
			padding-top: 0.5rem;
			border-inline-start: 0;
			border-top: 1px solid var(--color-line);
		}

		.conv-top {
			flex-wrap: wrap;
			gap: 0.35rem 1rem;
		}
	}

	@media (min-width: 1024px) and (max-height: 820px) {
		.conv-row {
			padding-block: 0.6rem;
		}

		.conv-closing {
			margin-top: 1rem;
			padding-top: 1rem;
		}
	}

	/* Reduced motion: no displacement; the rules still arrive. */
	@media (prefers-reduced-motion: reduce) {
		.process-conv.is-animated .conv-row,
		.process-conv.is-animated .conv-closing {
			translate: none;
		}

		.process-conv.is-animated.is-visible .conv-row::before {
			transition: none;
		}
	}
</style>
