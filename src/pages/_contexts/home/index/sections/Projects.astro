---
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import BaseButton from '@/infra/components/BaseButton.vue';
import type { Locale } from '@/config';
import { homeCopy } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang].projects;
const contactHref = '#perfil-contacto';
---

<section
	id="proyectos"
	class="section-glow border-b border-line [--glow-color:var(--glow-plate)] [--glow-x:0%]"
>
	<div
		class="slide-anim flex flex-col items-start gap-6 px-[1.125rem] pt-13 pb-[1.875rem] md:px-6 md:pt-14 lg:flex-row lg:items-end lg:justify-between lg:px-11 lg:pt-19 lg:pb-9.5"
	>
		<div class="max-w-[672px]">
			<p class="eyebrow">{copy.eyebrow}</p>
			<h2
				class="mt-4 text-[clamp(1.875rem,3.1vw,3.5rem)] leading-[1.08] tracking-[-0.028em] lg:leading-[1.04] lg:tracking-[-0.032em]"
			>
				{copy.title}
			</h2>
			<p class="mt-4 max-w-[600px] text-base leading-[1.7] text-muted md:mt-5 md:text-[17px]">
				{copy.description}
			</p>
		</div>
		<BaseButton href={contactHref} variant="ghost">
			{copy.cta}
			<ArrowIcon slot="trailing" class="size-4 shrink-0" />
		</BaseButton>
	</div>

	<div class="slide-anim px-[1.125rem] pb-12 md:px-6 lg:px-11 lg:pb-17">
		<div class="flex items-baseline justify-between gap-4">
			<p class="eyebrow">{copy.experienceLabel}</p>
			<p
				class="hidden font-mono text-[0.625rem] leading-none text-subtle lg:block"
				aria-hidden="true"
			>
				{copy.keyboardHint}
			</p>
		</div>

		<div class="projects-md mt-4">
			<div class="company-index" role="radiogroup" aria-label={copy.groupLabel}>
				{
					copy.items.map((company, index) => (
						<>
							<input
								class="company-radio"
								type="radio"
								name="company"
								id={`company-${company.slug}`}
								checked={index === 0}
							/>
							<label class="company-row" for={`company-${company.slug}`}>
								<span class="company-number">{String(index + 1).padStart(2, '0')}</span>
								<span class="company-mark" aria-hidden="true">
									{company.logo ? (
										<img
											src={company.logo}
											alt=""
											width="28"
											height="28"
											loading="lazy"
											decoding="async"
										/>
									) : (
										company.mark
									)}
								</span>
								<span class="min-w-0">
									<span class="company-name block text-[0.9375rem] font-medium leading-[1.25] tracking-[-0.015em]">
										{company.name}
									</span>
									<span class="company-meta">
										{company.meta} · {company.period}
									</span>
								</span>
								<span class="company-count">
									{String(company.projects.length).padStart(2, '0')}
								</span>
							</label>
						</>
					))
				}
			</div>

			<div class="company-detail">
				{
					copy.items.map((company) => (
						<article
							class="company-panel"
							id={`panel-${company.slug}`}
							aria-labelledby={`company-title-${company.slug}`}
						>
							<header class="company-head">
								<div class="flex items-center gap-3">
									<span class="company-mark company-mark-lg" aria-hidden="true">
										{company.logo ? (
											<img
												src={company.logo}
												alt=""
												width="48"
												height="48"
												loading="lazy"
												decoding="async"
											/>
										) : (
											company.mark
										)}
									</span>
									<div class="min-w-0">
										<h3
											id={`company-title-${company.slug}`}
											class="text-[1.5rem] font-semibold leading-[1.1] tracking-[-0.028em] md:text-[1.75rem]"
										>
											{company.name}
										</h3>
										<p class="mt-0.5 font-mono text-[0.625rem] leading-none tracking-[0.03em] text-subtle">
											{company.meta}
										</p>
									</div>
									<span class="ms-auto shrink-0 font-mono text-[0.625rem] leading-none text-subtle">
										{company.period}
									</span>
								</div>

								<p class="mt-2 max-w-[54rem] text-[0.8125rem] leading-[1.6] text-muted">
									{company.context}
								</p>

								<ul class="mt-2 flex flex-wrap gap-1.5">
									{company.tags.map((tag) => (
										<li class="rounded-xs border border-line bg-ink/[0.03] px-2 py-0.5 font-mono text-[0.625rem] leading-normal text-muted">
											{tag}
										</li>
									))}
								</ul>
							</header>

							<div class="company-body">
								{company.projects.map((project, projectIndex) => (
									<article class="company-project">
										<div class="flex items-baseline justify-between gap-4">
											<h4 class="text-[0.9375rem] font-semibold leading-[1.25] tracking-[-0.015em]">
												{project.name}
											</h4>
											<span class="font-mono text-[0.5625rem] leading-none text-subtle">
												{String(projectIndex + 1).padStart(2, '0')}
											</span>
										</div>
										<p class="mt-1 text-[0.75rem] leading-[1.5] text-muted">
											{project.detail}
										</p>

										<div class="company-project-grid">
											<div>
												<p class="eyebrow">{copy.participationLabel}</p>
												<ul class="mt-1.5 grid gap-1 text-[0.75rem] leading-[1.55] text-muted">
													{project.participation.map((line) => (
														<li class="flex gap-2">
															<span
																class="mt-[0.5em] size-1 shrink-0 rounded-full bg-accent"
																aria-hidden="true"
															/>
															<span>{line}</span>
														</li>
													))}
												</ul>
											</div>
											<div>
												<p class="eyebrow">{copy.solutionsLabel}</p>
												<ul class="mt-1.5 grid gap-1.5">
													{project.solutions.map((solution) => (
														<li class="border-s-2 border-accent/55 ps-2.5">
															<p class="text-[0.75rem] font-medium leading-[1.35] text-ink/85">
																{solution.title}
															</p>
															<p class="mt-0.5 text-[0.6875rem] leading-[1.45] text-muted">
																{solution.detail}
															</p>
														</li>
													))}
												</ul>
											</div>
										</div>

										<div class="mt-3">
											<p class="eyebrow">{copy.stackLabel}</p>
											<ul class="mt-1.5 flex flex-wrap gap-1.5">
												{project.stack.map((item) => (
													<li class="rounded-xs border border-line bg-ink/[0.03] px-2 py-0.5 font-mono text-[0.625rem] leading-normal text-muted">
														{item}
													</li>
												))}
											</ul>
										</div>
									</article>
								))}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Master–detail on radios: the switch is CSS only, so the panel does not
	   depend on JavaScript to exist. */
	.projects-md {
		display: grid;
		gap: 0.75rem;
	}

	.company-index {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.company-radio {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		margin: 0;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.company-row {
		display: grid;
		grid-template-columns: 1.4rem 1.75rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 0.55rem 0.55rem 0.6rem;
		border-left: 2px solid transparent;
		border-radius: 0 6px 6px 0;
		cursor: pointer;
		transition:
			background 160ms ease,
			border-color 160ms ease;
	}

	.company-row:hover {
		background: color-mix(in oklab, var(--color-surface) 55%, transparent);
	}

	.company-number,
	.company-count {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1;
		color: var(--color-subtle);
	}

	.company-meta {
		display: block;
		margin-top: 0.125rem;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		line-height: 1.4;
		letter-spacing: 0.02em;
		color: var(--color-muted);
	}

	.company-mark {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: 6px;
		background: var(--logo-plate);
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.02em;
		color: var(--color-muted);
	}

	.company-mark img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 4px;
	}

	.company-mark-lg {
		width: 3rem;
		height: 3rem;
		border-radius: 8px;
		font-size: 0.75rem;
	}

	.company-mark-lg img {
		padding: 6px;
	}

	.company-radio:checked + .company-row {
		border-left-color: var(--color-accent);
		background: var(--color-surface);
	}

	.company-radio:checked + .company-row .company-name {
		font-weight: 600;
	}

	.company-radio:focus-visible + .company-row {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
	}

	.company-detail {
		position: relative;
		display: grid;
		min-height: 0;
	}

	.company-panel {
		display: none;
		grid-template-rows: auto minmax(0, 1fr);
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-card);
		background: var(--color-page);
	}

	/* One rule per company: adding a company means adding its slug here. */
	.projects-md:has(#company-cuantia:checked) #panel-cuantia,
	.projects-md:has(#company-orinocodev:checked) #panel-orinocodev,
	.projects-md:has(#company-glgfreight:checked) #panel-glgfreight,
	.projects-md:has(#company-colegio-simon-bolivar:checked) #panel-colegio-simon-bolivar,
	.projects-md:has(#company-orinocoio:checked) #panel-orinocoio {
		display: grid;
	}

	.company-head {
		padding: 0.95rem 1.3rem 0.75rem;
		border-bottom: 1px solid var(--color-line);
	}

	.company-body {
		min-height: 0;
		overflow-y: auto;
		padding: 0.75rem 1.3rem 1rem;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: color-mix(in oklab, var(--color-ink) 22%, transparent) transparent;
	}

	.company-project + .company-project {
		margin-top: 0.7rem;
		padding-top: 0.65rem;
		border-top: 1px solid var(--color-line);
	}

	.company-project-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 1.5rem;
		margin-top: 0.4rem;
	}

	@media (min-width: 900px) {
		.projects-md {
			grid-template-columns: minmax(14.5rem, 18rem) minmax(0, 1fr);
			gap: clamp(1.5rem, 3vw, 3rem);
		}
	}

	@media (max-width: 899px) {
		.company-index {
			flex-direction: row;
			overflow-x: auto;
			gap: 0.375rem;
			padding-bottom: 0.5rem;
			scrollbar-width: none;
		}

		.company-index::-webkit-scrollbar {
			display: none;
		}

		.company-row {
			flex: none;
			grid-template-columns: auto auto;
			padding: 0.45rem 0.55rem;
			border-left: 0;
			border-bottom: 2px solid transparent;
			border-radius: 6px 6px 0 0;
			background: color-mix(in oklab, var(--color-surface) 45%, transparent);
		}

		.company-radio:checked + .company-row {
			border-left-color: transparent;
			border-bottom-color: var(--color-accent);
		}

		.company-number,
		.company-meta,
		.company-count {
			display: none;
		}

		.company-row .company-name {
			font-size: 0.8125rem;
			white-space: nowrap;
		}

		.company-mark {
			width: 1.5rem;
			height: 1.5rem;
			font-size: 0.5rem;
		}

		.company-mark-lg {
			width: 2.5rem;
			height: 2.5rem;
			font-size: 0.6875rem;
		}

		.company-head {
			padding: 0.95rem 1rem 0.85rem;
		}

		.company-body {
			padding: 0.9rem 1rem 1rem;
		}

		.company-project-grid {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}
	}

	/* Shorter laptops: tighten the panel before it needs its own scrollbar. */
	@media (min-width: 1024px) and (max-height: 820px) {
		.company-row {
			padding-block: 0.5rem;
		}

		.company-head {
			padding: 0.7rem 1.2rem 0.65rem;
		}

		.company-body {
			padding: 0.6rem 1.2rem 0.5rem;
		}

		.company-project + .company-project {
			margin-top: 0.55rem;
			padding-top: 0.5rem;
		}

		.company-project-grid {
			gap: 1.25rem;
		}
	}
</style>
