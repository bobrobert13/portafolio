---
import BaseLayout from '@/infra/layouts/BaseLayout.astro';
import ArrowIcon from '@/infra/components/ArrowIcon.astro';
import { t } from '@/i18n/ui';
import { site, type Locale } from '@/config';
import Hero from './sections/Hero.astro';
import Profile from './sections/Profile.astro';
import BuildProcess from './sections/BuildProcess.astro';
import Projects from './sections/Projects.astro';
import Tools from './sections/Tools.astro';
import Manifesto from './sections/Manifesto.astro';
import Services from './sections/Services.astro';
import Contact from './sections/Contact.astro';
import { homeCopy } from './i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = homeCopy[lang];
---

<BaseLayout locale={lang} title={`${copy.meta.title} · ${site.name}`} description={copy.meta.description}>
	<div class="slide-stack">
		<div class="slide"><Hero lang={lang} /></div>
		<div class="slide"><Profile lang={lang} /></div>
		<div class="slide"><BuildProcess lang={lang} /></div>
		<div class="slide"><Projects lang={lang} /></div>
		<div class="slide"><Tools lang={lang} /></div>
		<div class="slide"><Manifesto lang={lang} /></div>
		<div class="slide"><Services lang={lang} /></div>
		<div class="slide"><Contact lang={lang} /></div>
	</div>
	<button
		type="button"
		data-section-nav
		data-label-next={t(lang, 'a11y.nextSection')}
		data-label-top={t(lang, 'a11y.backToTop')}
		aria-label={t(lang, 'a11y.nextSection')}
		aria-hidden="true"
		tabindex="-1"
		title={t(lang, 'a11y.nextSection')}
		class="section-nav group fixed bottom-5 left-1/2 z-40 flex -translate-x-1/2 items-center gap-2.5 rounded-full border border-line bg-page/85 py-1.5 pe-1.5 ps-3.5 text-ink opacity-0 translate-y-2 pointer-events-none backdrop-blur-md transition-[opacity,transform,border-color,background-color] duration-300 hover:border-ink/25 hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
	>
		<span
			aria-hidden="true"
			class="font-mono text-[10px] leading-none tracking-[0.08em] text-muted"
		>
			<span data-section-nav-current class="text-ink">01</span>
			<span class="mx-1 text-subtle">/</span>
			<span data-section-nav-total>08</span>
		</span>
		<span
			class="grid size-9 place-items-center rounded-full bg-accent text-accent-ink shadow-btn transition-[filter] duration-150 group-hover:brightness-105"
		>
			<span class="section-nav-arrow grid size-4 place-items-center">
				<ArrowIcon class="size-4" />
			</span>
		</span>
	</button>
</BaseLayout>

<script>
	const stack = document.querySelector<HTMLElement>('.slide-stack');
	const sectionNav = document.querySelector<HTMLButtonElement>('[data-section-nav]');
	const stacked = window.matchMedia('(min-width: 1024px) and (min-height: 720px)');

	/* The sheet presentation only exists on viewports that can hold the
	   compacted desktop layout; everywhere else the page flows normally. */
	const active = () => stacked.matches;

	if (stack) {
		const sheets = Array.from(stack.querySelectorAll<HTMLElement>('.slide'));

		const sheetOf = (target: Element | null) => target?.closest<HTMLElement>('.slide') ?? null;
		const stackTop = () => stack.getBoundingClientRect().top + window.scrollY;
		/* Sticky offsets leak into `offsetTop` once a sheet is pinned, so derive
		   the layout position from the stack instead. */
		const sheetHeight = () => stack.getBoundingClientRect().height / sheets.length;
		const sheetTop = (sheet: HTMLElement) =>
			stackTop() + sheets.indexOf(sheet) * sheetHeight();

		/* Section nav: on the sheet layout the offset comes from the stack (a
		   pinned sheet's rect sits at the viewport top); in normal flow the
		   rect is the document position. The sticky header is compensated by
		   the document's scroll padding. */
		const scrollPad = () =>
			parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;

		const navTop = (sheet: HTMLElement) =>
			active()
				? sheetTop(sheet)
				: sheet.getBoundingClientRect().top + window.scrollY - scrollPad();

		const currentIndex = () => {
			const y = window.scrollY + scrollPad() + 1;
			let index = 0;

			sheets.forEach((sheet, i) => {
				const top = active()
					? sheetTop(sheet)
					: sheet.getBoundingClientRect().top + window.scrollY;
				if (top <= y) index = i;
			});

			return index;
		};

		const clamp = (value: number) => Math.min(1, Math.max(0, value));
		const applied = sheets.map(() => ({ drift: '', fade: '' }));

		/* Sheet `i` enters while scrolling through `[(i - 1) × vh, i × vh]` and
		   is covered through `[i × vh, (i + 1) × vh]`. Content drifts up while
		   leaving and settles down while entering; the last sheet just scrolls
		   away with the footer instead of being covered. */
		const paint = () => {
			if (!active()) {
				for (const sheet of sheets) sheet.classList.remove('is-offstage');
				return;
			}
			const start = stackTop();
			const height = sheetHeight();
			const y = window.scrollY;

			sheets.forEach((sheet, index) => {
				const enter =
					index === 0 ? 1 : clamp((y - start - (index - 1) * height) / height);
				const leave =
					index === sheets.length - 1
						? 0
						: clamp((y - start - index * height) / height);
				const drift = (1 - enter - leave).toFixed(3);
				const fade = ((1 - enter + leave) * 0.65).toFixed(3);
				const state = applied[index];

				/* Ambient loops only run while their sheet is on stage. */
				sheet.classList.toggle(
					'is-offstage',
					enter === 0 || leave >= 0.999,
				);

				if (state && state.drift !== drift) {
					sheet.style.setProperty('--drift', drift);
					state.drift = drift;
				}
				if (state && state.fade !== fade) {
					sheet.style.setProperty('--fade', fade);
					state.fade = fade;
				}
			});
		};

		let frame = 0;
		const schedule = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				paint();
				updateSectionNav();
			});
		};

		const goTo = (sheet: HTMLElement, behavior: ScrollBehavior) => {
			window.scrollTo({ top: sheetTop(sheet), behavior });
		};

		const goToHash = (behavior: ScrollBehavior) => {
			if (!active()) return;
			const hash = window.location.hash;
			if (hash.length < 2) return;
			const sheet = sheetOf(document.getElementById(hash.slice(1)));
			if (sheet) goTo(sheet, behavior);
		};

		document.addEventListener('click', (event) => {
			if (!active()) return;
			const link = (event.target as Element | null)?.closest?.('a[href^="#"]');
			if (!link) return;
			const hash = link.getAttribute('href') ?? '';
			if (hash.length < 2) return;
			const sheet = sheetOf(document.getElementById(hash.slice(1)));
			if (!sheet) return;
			event.preventDefault();
			goTo(sheet, 'smooth');
			history.replaceState(null, '', hash);
		});

		/* A sheet stays pinned while it is covered, so its layout position is
		   above the viewport: focusing content there would scroll the page away
		   from the visible sheet. Align the sheet that owns the focused node. */
		document.addEventListener('focusin', (event) => {
			if (!active()) return;
			const sheet = sheetOf(event.target as Element);
			if (!sheet) return;
			const top = sheetTop(sheet);
			if (Math.abs(window.scrollY - top) > 2) {
				window.scrollTo({ top, behavior: 'instant' });
			}
		});

		const updateSectionNav = () => {
			if (!sectionNav) return;

			const current = currentIndex();
			const up = current >= sheets.length - 1;
			const currentEl = sectionNav.querySelector<HTMLElement>('[data-section-nav-current]');
			const totalEl = sectionNav.querySelector<HTMLElement>('[data-section-nav-total]');

			sectionNav.dataset.direction = up ? 'up' : 'down';
			if (currentEl) currentEl.textContent = String(current + 1).padStart(2, '0');
			if (totalEl) totalEl.textContent = String(sheets.length).padStart(2, '0');

			const label = up
				? (sectionNav.dataset.labelTop ?? '')
				: (sectionNav.dataset.labelNext ?? '');

			sectionNav.setAttribute('aria-label', label);
			sectionNav.title = label;
		};

		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		stacked.addEventListener('change', schedule);
		window.addEventListener('hashchange', () => goToHash('smooth'));
		sectionNav?.addEventListener('click', () => {
			const current = currentIndex();

			if (current >= sheets.length - 1) {
				window.scrollTo({ top: 0, behavior: 'smooth' });
				return;
			}

			window.scrollTo({
				top: navTop(sheets[current + 1]),
				behavior: 'smooth',
			});
		});

		paint();
		updateSectionNav();

		if (sectionNav) {
			sectionNav.removeAttribute('aria-hidden');
			sectionNav.tabIndex = 0;
			sectionNav.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
			sectionNav.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
		}

		requestAnimationFrame(() => goToHash('instant'));
	}
</script>

<style>
	.section-nav-arrow {
		transform: rotate(90deg);
		transition:
			transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
			translate 180ms ease;
	}

	.section-nav[data-direction='up'] .section-nav-arrow {
		transform: rotate(-90deg);
	}

	.section-nav:hover .section-nav-arrow {
		translate: 0 2px;
	}

	.section-nav[data-direction='up']:hover .section-nav-arrow {
		translate: 0 -2px;
	}
</style>
